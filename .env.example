# ─────────────────────────────────────────────────────────────────────────────
# LeetCode GitHub Sync — environment variables
#
# Copy this file to .env.local and fill in your values.
# Variables prefixed with PLASMO_PUBLIC_ are embedded in the extension bundle
# and are visible to end users — never put secrets there.
# ─────────────────────────────────────────────────────────────────────────────

# Your GitHub OAuth App's client_id (public — safe to embed).
# Create one at: https://github.com/settings/developers → "New OAuth App"
# Authorization callback URL: https://<your-extension-id>.chromiumapp.org/github
# (Run `plasmo dev` once to get your extension ID, then update the callback URL)
PLASMO_PUBLIC_GITHUB_CLIENT_ID=your_github_oauth_app_client_id

# URL of the serverless proxy that exchanges the OAuth code for an access token.
# The proxy holds your client_secret and is the only piece that needs a server.
# A ready-to-deploy Cloudflare Worker is in /proxy/ — see proxy/README.md.
# If you use PAT-only auth, you can leave this blank.
PLASMO_PUBLIC_TOKEN_EXCHANGE_URL=https://your-proxy.example.com/api/github-oauth
