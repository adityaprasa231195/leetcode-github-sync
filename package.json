{
  "name": "leetcode-github-sync",
  "displayName": "LeetCode GitHub Sync",
  "version": "1.0.0",
  "description": "Automatically sync accepted LeetCode solutions to your GitHub repository.",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/generate-icons.js",
    "predev": "node scripts/generate-icons.js",
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:edge": "plasmo build --target=edge-mv3",
    "package": "plasmo package",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.2",
    "@plasmohq/messaging": "^0.6.2",
    "@plasmohq/storage": "^1.13.0",
    "plasmo": "^0.90.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.39",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3"
  },
  "manifest": {
    "host_permissions": [
      "https://leetcode.com/*",
      "https://github.com/*",
      "https://api.github.com/*"
    ],
    "permissions": [
      "storage",
      "notifications",
      "alarms"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
    }
  }
}
